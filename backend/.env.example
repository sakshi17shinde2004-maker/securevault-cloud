# ---- Copy this file to ".env" and change the values ----
DATABASE_URL=mysql+pymysql://securevault:SecureVault_123@localhost:3306/securevault_db

# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# First ADMIN account (created automatically on first start if no admin exists)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-Admin123

# local  = files in ./uploads        s3 = Amazon S3 (AWS phase)
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
DEFAULT_QUOTA_MB=100

# Only for STORAGE_BACKEND=s3 (never put AWS keys here - use an IAM Role)
S3_BUCKET=
AWS_REGION=ap-south-1
